# Stoiber Vivien — szegmentáló kvíz
# Az .env.local fájlba másold át és töltsd ki a kulcsokat.

# Saját URL (csak akkor szükséges, ha custom domain alá kerül)
NEXT_PUBLIC_SITE_URL=https://stoiber-vivien-kviz.vercel.app

# MailerLite (opcionális — ha hiányzik, a feliratkozás kliens-oldalt sikeres
# state-et mutat, de szerver oldalt no-op)
MAILERLITE_API_KEY=
MAILERLITE_GROUP_ID=
